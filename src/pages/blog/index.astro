---
import SiteLayout from '../../layouts/SiteLayout.astro'
import BlogIndex from '../../blog/BlogIndex'

const title = 'Office SDK Journal | Embedded Office workflows'
const description = 'Practical Office SDK articles on embedded document workflows, format fit, security, migration, and operations.'
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Office SDK Journal',
  description,
  url: 'https://officesdk.com/blog',
  inLanguage: 'en',
  dateModified: '2026-09-29',
  publisher: { '@id': 'https://officesdk.com/#organization' },
}
---

<SiteLayout {title} {description} canonical="/blog" schemas={[blogSchema]}>
  <BlogIndex client:load />
</SiteLayout>
