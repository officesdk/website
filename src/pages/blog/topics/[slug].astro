---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import { BlogCard } from '../../../blog/BlogIndex'
import { blogTopics, topicEntries } from '../../../blog/topics'
import type { BlogTopic } from '../../../blog/topics'

export function getStaticPaths() {
  return blogTopics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }))
}

const { topic } = Astro.props as { topic: BlogTopic }
const entries = topicEntries(topic)
const others = blogTopics.filter(item => item.slug !== topic.slug)
---

<SiteLayout title={`${topic.title} | Office SDK Journal`} description={topic.description} canonical={`/blog/topics/${topic.slug}`}>
  <header class="topic-hero">
    <div class="container">
      <nav class="article-breadcrumb topic-breadcrumb" aria-label="Journal navigation">
        <a href="/blog">All stories</a>
        <span>Topic hub</span>
      </nav>
      <span class="section-index">JOURNAL TOPIC</span>
      <h1>{topic.h1}</h1>
      <p class="topic-intro">{topic.intro}</p>
      <p class="topic-count">{entries.length} {entries.length === 1 ? 'article' : 'articles'} · {topic.tags.join(' + ')}</p>
    </div>
  </header>
  <section class="topic-library container" aria-label={`Articles about ${topic.title}`}>
    <div class="journal-grid">{entries.map(entry => <BlogCard entry={entry} />)}</div>
  </section>
  <section class="topic-more container" aria-label="Other topic hubs">
    <span class="section-index">KEEP EXPLORING</span>
    <div class="topic-more-rail">
      {others.map(item => <a href={`/blog/topics/${item.slug}`}>{item.title}</a>)}
    </div>
  </section>
</SiteLayout>
