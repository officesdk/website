---
import SiteLayout from '../layouts/SiteLayout.astro'
import { Hero, HomeEvidence, WorkflowThemes, ProductSection, FormatsSection, SolutionsSection, DeploymentSection, ResourcesSection, FAQ, FinalCTA } from '../components/SiteSections'
import { CoreEditorsBand } from '../components/CoreEditorsStory'
import CapabilityArchitecture from '../components/CapabilityArchitecture'
import { faqs } from '../content'

const title = 'Office SDK | Build Office workflows into your product'
const description = 'Office SDK brings Word, Excel, and PowerPoint preview, editing, collaboration, import, export, and content workflows into your web product.'
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
}
---

<SiteLayout {title} {description} canonical="/" schemas={[faqSchema]}>
  <Hero client:load />
  <CapabilityArchitecture client:load />
  <CoreEditorsBand />
  <HomeEvidence />
  <WorkflowThemes />
  <ProductSection />
  <FormatsSection />
  <SolutionsSection />
  <DeploymentSection />
  <ResourcesSection />
  <FAQ />
  <FinalCTA />
</SiteLayout>
