---
import SiteLayout from '../layouts/SiteLayout.astro'
import { Hero, HomeEvidence, WorkflowThemes, ProductSection, FormatsSection, SolutionsSection, DeploymentSection, ResourcesSection, FAQ, FinalCTA } from '../components/SiteSections'
import { CoreEditorsBand } from '../components/CoreEditorsStory'
import CapabilityArchitecture from '../components/CapabilityArchitecture'
import { faqs } from '../content'
import { editorImages } from '../editor-images'

const title = 'Office SDK — Embed Word, Excel & PowerPoint | Self-Hosted'
const description = 'Embed Word, Excel and PowerPoint editing in your app. Self-host on your infrastructure, keep control of files and permissions, and talk to our team about evaluation.'
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
}
---

<SiteLayout {title} {description} canonical="/" schemas={[faqSchema]}>
  <Hero client:load images={editorImages} />
  <CapabilityArchitecture client:load />
  <CoreEditorsBand />
  <HomeEvidence />
  <WorkflowThemes />
  <ProductSection />
  <FormatsSection />
  <SolutionsSection />
  <DeploymentSection />
  <ResourcesSection />
  <FAQ />
  <FinalCTA />
</SiteLayout>
