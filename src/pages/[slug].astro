---
import SiteLayout from '../layouts/SiteLayout.astro'
import { SeoPageView, ContactForm, AudienceLine } from '../components/SiteSections'
import { seoPages, type SiteRoute } from '../seo'

export function getStaticPaths() {
  return Object.values(seoPages).map((page) => ({
    params: { slug: page.path.slice(1) },
    props: { page },
  }))
}

const { page } = Astro.props as { page: (typeof seoPages)[Exclude<SiteRoute, '/'>] }
---

<SiteLayout title={page.title} description={page.description} canonical={page.path}>
  {page.path === '/contact' ? (
    <section class="contact-section contact-page" id="contact-form" aria-labelledby="contact-heading">
      <div class="container contact-layout">
        <div class="contact-intro">
          <h1 id="contact-heading">Talk to<em>our team.</em></h1>
          <AudienceLine className="contact-tagline" />
          <p class="contact-deployment"><strong>Self-hosted</strong> on your infrastructure.</p>
        </div>
        <ContactForm client:load />
      </div>
    </section>
  ) : <SeoPageView page={page} />}
</SiteLayout>
