---
import { Header, Footer } from '../components/SiteSections'
import PointerBackdrop from '../components/PointerBackdrop.astro'
import '../styles.css'
import '../blog/blog.css'
import '../site-theme.css'

interface Props {
  title: string
  description: string
  canonical: string
  image?: string
  schemas?: Record<string, unknown>[]
  articleSchema?: boolean
}

const {
  title,
  description,
  canonical,
  image,
  schemas = [],
  articleSchema = false,
} = Astro.props
const siteOrigin = 'https://officesdk.com'
// Pages without a specific cover fall back to the shared brand card so every
// route ships og:image/twitter:image for link previews.
const socialImage = image ?? '/brand/og-default.png'
const organization = {
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: 'Office SDK',
  url: `${siteOrigin}/`,
  email: 'support@officesdk.com',
  sameAs: ['https://github.com/officesdk/'],
}
const software = {
  '@type': 'SoftwareApplication',
  '@id': `${siteOrigin}/#software`,
  name: 'Office SDK',
  applicationCategory: 'BusinessApplication',
  description: 'A web-based Office document surface for preview, editing, collaboration, import, export, and content workflows inside products.',
  email: 'support@officesdk.com',
  publisher: { '@id': `${siteOrigin}/#organization` },
}
const graph = { '@context': 'https://schema.org', '@graph': [organization, software] }
const serializeSchema = (schema: Record<string, unknown>) => JSON.stringify(schema).replaceAll('<', '\\u003c')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteOrigin}${canonical}`} />
    <meta property="og:type" content={articleSchema ? 'article' : 'website'} />
    <meta property="og:site_name" content="Office SDK" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${siteOrigin}${canonical}`} />
    <meta property="og:image" content={`${siteOrigin}${socialImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Office SDK — Embed Word, Excel and PowerPoint in your app" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}${socialImage}`} />
    <!-- Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      // Local QA and Pages preview builds must not pollute production reports.
      if (location.hostname === 'officesdk.com') {
        gtag('config', 'G-9SF2PEB5YX');
        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-9SF2PEB5YX';
        document.head.appendChild(tag);
      }
    </script>
    <title>{title}</title>
    <script type="application/ld+json" set:html={serializeSchema(graph)}></script>
    {schemas.map((schema) => <script type="application/ld+json" data-blog-schema={articleSchema ? '' : undefined} set:html={serializeSchema(schema)}></script>)}
  </head>
  <body>
    <PointerBackdrop />
    <div class="app-shell">
      <Header client:load />
      <main><slot /></main>
      <Footer />
    </div>
    <script>
      import { installAnalytics } from '../analytics'
      installAnalytics()
    </script>
  </body>
</html>
